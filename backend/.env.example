# CareerPilot AI Backend Environment Configuration Template
PORT=5000
NODE_ENV=production

# Supabase Credentials
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Legacy aliases for older scripts; prefer the new key names above.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Configuration ('gemini' or 'ollama')
AI_PROVIDER=gemini
GOOGLE_API_KEY=

# Ollama Local Service Configuration (if AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# CORS Allowed Frontend Origins (comma-separated for multiple domains)
FRONTEND_ORIGIN=
